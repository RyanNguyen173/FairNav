# Copy this file to .env and fill in your keys.
# Both are used only server-side (api/gemini.ts, api/resume-parser.ts) -
# never exposed to the browser.

# Company matching + pitch generation. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Resume parsing (Step 1). Get a key at https://apilayer.com/marketplace/resume_parser-api
RESUME_PARSER_API_KEY=your-apilayer-key-here
