# Copy this file to .env.local and fill in your keys (Next.js reads
# .env.local automatically, and it's already in .gitignore).

# Server-side only (app/api/parse-resume, parse-directory, rank-companies,
# generate-pitches route handlers) - never exposed to the browser.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Client-side (auth + encrypted data storage). The NEXT_PUBLIC_ prefix means
# Next.js bundles these into the browser build - that's expected: the
# Supabase anon key is a public, RLS-protected key by design, not a secret.
# Get both from your Supabase project's Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
