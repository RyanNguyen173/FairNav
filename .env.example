# Copy this file to .env and fill in your keys.

# Server-side only (api/parse-resume.ts, api/parse-directory.ts,
# api/rank-companies.ts, api/generate-pitches.ts) - never exposed to the browser.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Client-side (auth + encrypted data storage). The VITE_ prefix means Vite
# bundles these into the browser build - that's expected: the Supabase anon
# key is a public, RLS-protected key by design, not a secret. Get both from
# your Supabase project's Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
